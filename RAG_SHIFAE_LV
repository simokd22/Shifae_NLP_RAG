and in a professional style.\n        You must always start your answer with \"بسم الله الرحمن الرحيم\", followed by an appropriate greeting (like \"السلام عليكم ورحمة الله وبركاته\").\n        Present the answer in one continuous, clear paragraph based only on the following information.\n        Do not use bullet points or lists, and stop writing immediately after providing the answer.<|im_end|>\n        <|im_start|>user\n        Information: {context}\n        \n        Question: {question}<|im_end|>\n        <|im_start|>assistant\n        Answer: بسم الله الرحمن الرحيم، السلام عليكم ورحمة الله وبركاته، \"\"\"\n\ndef post_process_response(text: str) -> str:\n    if not text:\n        return \"\"\n    # Cut before any non-Arabic content or human prompts\n    text = re.sub(r'(?i)human:.*|user:.*|system:.*|assistant:.*', '', text, flags=re.DOTALL).strip()\n    if \"الإجابة:\" in text:\n        text = text.split(\"الإجابة:\", 1)[-1].strip()\n    text = re.sub(r'\\s+', ' ', text).strip()\n    text = re.sub(r'\\d+\\.\\s*', '', text)\n    text = re.sub(r'[-•]\\s*', '', text)\n    # Keep only Arabic (remove Chinese/English)\n    text = re.sub(r'[^\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF\\uFB50-\\uFDFF\\uFE70-\\uFEFF\\s.،؟!]+', '', text).strip()\n    text = clean_medical_text(text)\n    sentences = [s.strip() for s in re.split(r'[.!؟]', text) if s.strip() and len(s.split()) >= 5]\n    if sentences:\n        text = \". \".join(sentences) + \".\"\n    return text[0].upper() + text[1:] if text else \"\"\n\nGENERATION_MODE = \"EXTRACTIVE\"\ngenerator_pipeline = None\n\nprint(\"Loading Arabic model...\")\n\nfor config in MODEL_CONFIGS:\n    try:\n        print(f\"\\nAttempting: {config['name']}\")\n        tokenizer = AutoTokenizer.from_pretrained(config[\"name\"], trust_remote_code=True)\n        if tokenizer.pad_token is None:\n            tokenizer.pad_token = tokenizer.eos_token\n\n        model_kwargs = {\"device_map\": \"auto\", \"trust_remote_code\": True}\n        model_kwargs[\"torch_dtype\"] = torch.float16\n\n        model = AutoModelForCausalLM.from_pretrained(config[\"name\"], **model_kwargs)\n\n        generator_pipeline = pipeline(\"text-generation\", model=model, tokenizer=tokenizer)\n\n        # Test\n        test_context = \"الاكتئاب هو اضطراب نفسي يتميز بمشاعر الحزن وفقدان الاهتمام.\"\n        test_prompt = create_optimized_prompt(test_context, \"ما هي أعراض الاكتئاب؟\")\n        test_output = generator_pipeline(test_prompt, max_new_tokens=150, temperature=0.7, do_sample=True, eos_token_id=tokenizer.eos_token_id)[0]['generated_text']\n        cleaned = post_process_response(test_output)\n\n        if len(cleaned) > 30 and any(c in cleaned for c in 'ابتثجحخدذرزسشصضطظعغفقكلمنهوي'):\n            GENERATION_MODE = \"GENERATIVE\"\n            print(f\"Model loaded: {config['name']}\")\n            print(f\"Test: {cleaned[:100]}...\")\n            break\n\n    except Exception as e:\n        print(f\"Error: {str(e)[:120]}...\")\n        torch.cuda.empty_cache()\n        continue\n\nif GENERATION_MODE == \"GENERATIVE\":\n    def generate_answer_with_model(contexts: List[str], question: str) -> str:\n        try:\n            context = clean_context_for_generation(contexts)\n            if not context:\n                return \"Sorry, information is insufficient.\"\n            prompt = create_optimized_prompt(context, question)\n            result = generator_pipeline(prompt, max_new_tokens=400, temperature=0.6, top_p=0.85, repetition_penalty=1.4, do_sample=True, eos_token_id=tokenizer.eos_token_id)[0]['generated_text']\n            return post_process_response(result)\n        except:\n            return \"Sorry, an error occurred.\"\n\nelse:\n    def generate_answer_with_model(contexts: List[str], question: str) -> str:\n        sentences = []\n        for c in contexts:\n            clean = re.sub(r'\\[المصدر \\d+\\]:', '', c).strip()\n            clean = re.sub(r'\\s+', ' ', clean)\n            for s in re.split(r'[.!؟]', clean):\n                if len(s.strip()) > 25:\n                    sentences.append(s.strip())\n        return \". \".join(sentences[:4]) + \".\" if sentences else \"Sorry, insufficient information.\"\n\ndef generate_answer(contexts: List[str], question: str) -> str:\n    if not contexts:\n        return \"Sorry, no information available.\"\n    print(f\"Generation ({GENERATION_MODE})...\")\n    return generate_answer_with_model(contexts, question)\n\n# TEST\nprint(\"\\n\" + \"=\"*60)\ntest_contexts = [\n    \"[المصدر 1]: الاكتئاب هو اضطراب نفسي يتميز بمشاعر الحزن وفقدان الاهتمام. الأعراض تشمل تغيرات في النوم والشهية والتعب وصعوبة في التركيز.\",\n    \"[المصدر 2]: علاج الاكتئاب يشمل العلاج النفسي والأدوية المضادة للاكتئاب. العلاج المعرفي السلوكي فعال جداً. ممارسة الرياضة تساعد أيضاً.\",\n    \"[المصدر 3]: من المهم استشارة طبيب نفسي للتشخيص الدقيق والعلاج المناسب. الدعم الأسري يلعب دوراً هاماً في التحسن.\"\n]\ntest_question = \"ما هي أعراض الاكتئاب وكيف يمكن علاجه؟\"\nanswer = generate_answer(test_contexts, test_question)\nprint(f\"Answer:\\n«{answer}»\")\nprint(f\"Mode: {GENERATION_MODE}\")","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":763,"referenced_widgets":["0451450f2625448882b7204682cdcb9f","1b43fe6ac26b44399f84d32fe491c4f6","9a9705ea138b4d699891b3a068f7998d","b9ae74b895cf4edd8230bf4e86279609","0e52d3d31a09438d800cc486c3a044b3","3e38ef525ef14345aab2eb774be2c372","f26d3dafbbfd45bd99b8ef3db7878c5c","b0351cee5d1a4e3eab959e40a570b6ac","2538733aba9046018619ab3d68a38966","11e600205dac47e3bc3422034d82684b","c5c4e54c3bfc4d55be96b9dbf7f9a299","ae3b73be41ae4b0fa6f076c398362c72","87c5efd6c5874884a48f12832d267ad4","3f16517d6d7d44c99f964d77072ee9ee","57ffde6aefe44f36b774fd90950a8a79","68b4232bd4c04f12baf1d617cf55b1d5","638b3d0c00794933a80a960734ad16b4","5b381aade17b46daae61ea9f1d3958ee","f40f4e47305246f282d0338b0c2dfd0e","bda902245a50421491b903ab1c007d28","824a815ab1104d08a4a019c33c388ac2","f00c1625b2c0492493db2f4e7cee12ab","514b541f5836485fba3