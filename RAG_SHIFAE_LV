esponses\ninitial_count = len(data)\ndata = data.dropna(subset=['Answer'])\ndata = data[data['Answer'].str.len() > 50]\nprint(f\"Responses retained: {len(data)} (removed: {initial_count - len(data)})\")\n\n# Filter rare diagnoses\nif 'Hierarchical Diagnosis' in data.columns:\n    diagnosis_counts = data['Hierarchical Diagnosis'].value_counts()\n    diagnoses_to_keep = diagnosis_counts[diagnosis_counts >= 10].index\n    data = data[data['Hierarchical Diagnosis'].isin(diagnoses_to_keep)]\n    print(f\"Preserved diagnoses: {len(diagnoses_to_keep)}\")\n\ndef normalize_arabic_text(text: str) -> str:\n    if not isinstance(text, str):\n        return \"\"\n\n    # Normalisation des caractères\n    text = araby.normalize_hamza(text)\n    text = araby.normalize_alef(text)\n    text = araby.normalize_teh(text)\n    text = araby.strip_tashkeel(text)\n    text = araby.strip_tatweel(text)\n    text = araby.normalize_ligature(text)\n    text = re.sub(r'[^\\u0600-\\u06FF0-9\\s\\.\\,\\?\\!\\%\\-\\+]', '', text)\n\n    # Normalisation de la ponctuation arabe\n    text = re.sub(r'[،]', ',', text)\n    text = re.sub(r'[؛]', ';', text)\n    text = re.sub(r'[؟]', '?', text)\n\n    return text\n\ndef clean_medical_text(text: str) -> str:\n    if not isinstance(text, str) or pd.isna(text):\n        return \"\"\n\n    text = str(text)\n    text = normalize_arabic_text(text)\n    text = re.sub(r'http\\S+|www\\S+|https\\S+', '', text, flags=re.MULTILINE)\n    text = re.sub(r'\\S+@\\S+', '', text)\n    text = re.sub(r'\\+\\d{6,}', '', text)\n    text = re.sub(r'\\s+', ' ', text)\n    text = re.sub(r'\\s*\\.\\s*', '. ', text)\n    text = re.sub(r'\\s*,\\s*', ', ', text)\n    text = text.strip()\n\n    return text\n\ndata = data.copy()\ndata['processed_answer'] = data['Answer'].apply(lambda x: clean_medical_text(x))\n\nif 'question_text' in data.columns:\n    data['processed_question'] = data['question_text'].apply(lambda x: clean_medical_text(x))\n\nprint(\"\\nStatistics after preprocessing:\