G [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"56884206646240879a8fb3c3ca41255f"}},"metadata":{}},{"name":"stderr","text":"Some weights of XLMRobertaForSequenceClassification were not initialized from the model checkpoint at sentence-transformers/paraphrase-multilingual-mpnet-base-v2 and are newly initialized: ['classifier.dense.bias', 'classifier.dense.weight', 'classifier.out_proj.bias', 'classifier.out_proj.weight']\nYou should probably TRAIN this model on a down-stream task to be able to use it for predictions and inference.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/402 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"236d2dc3d16b4ad198c851947944d56c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"sentencepiece.bpe.model:   0%|          | 0.00/5.07M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5335e5f1af6f4ad0bb6c689995b14bbe"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ff160ace622a44be9a2a0fce9002dfb4"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/239 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5ad2ae6c771647648be9731aebc0b54f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b439de27a36c4c93a7cab560a2b600c4"}},"metadata":{}},{"name":"stdout","text":"Validating retrieval data...\nData validated: 137100 answer chunks\n\nRetriever initialized successfully!\n   • Available answer chunks: 137,100\n   • Vectors in index: 137,100\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"## **6. SYSTEMATIC RETRIEVAL EVALUATION WITH TEST DATA**","metadata":{"id":"BgVDlVXLTfi4"}},{"cell_type":"code","source":"class RetrievalEvaluator:\n    def __init__(self, retriever, test_data):\n        self.retriever = retriever\n        self.test_data = test_data\n        self.results = []\n        \n    def calculate_binary_relevance(self, ground_truth_answer, retrieved_chunk, threshold=0.7):\n        try:\n            # Calculate cosine similarity between ground truth and retrieved chunk\n            gt_embedding = self.retriever.embedding_model.encode(\n                [ground_truth_answer],\n                normalize_embeddings=True,\n                show_progress_bar=False\n            )[0]\n            \n            chunk_embedding = self.retriever.embedding_model.encode(\n                [retrieved_chunk],\n                normalize_embeddings=True,\n                show_progress_bar=False\n            )[0]\n            \n            similarity = np.dot(gt_embedding, chunk_embedding) / (\n                np.linalg.norm(gt_embedding) * np.linalg.norm(chunk_embedding)\n            )\n            \n            return 1 if similarity >= threshold else 0\n        except Exception as e:\n            print(f\"Error calculating relevance: {e}\")\n            return 0\n    \n    def calculate_precision_at_k(self, results, ground_truth, k_values=[1, 3, 5, 10]):\n        precision_scores = {}\n        \n        for k in k_values:\n            top_k = results[:k] if len(results) >= k else results\n            if not top_k:\n                precision_scores[f'P@{k}'] = 0.0\n                continue\n                \n            # Calculate relevant documents in top-k\n            relevant_count = 0\n            for result in top_k:\n                relevance = self.calculate_binary_relevance(\n                    ground_truth, \n                    result['content']\n                )\n                relevant_count += relevance\n                # Store relevance for future use\n                result[f'is_relevant'] = relevance\n            \n            precision = relevant_count / k\n            precision_scores[f'P@{k}'] = precision\n            \n        return precision_scores\n    \n    def calculate_recall_at_k(self, results, ground_truth, total_relevant_docs, k_values=[1, 3, 5, 10]):\n        recall_scores = {}\n        if total_relevant_docs == 0:\n            total_relevant_docs = 1\n        \n        for k in k_values:\n            top_k = results[:k] if len(results) >= k else results\n            if not top_k:\n                recall_scores[f'R@{k}'] = 0.0\n                continue\n            \n            # Calculate relevant documents in top-k\n            relevant_count = 0\n            for result in top_k:\n                if 'is_relevant' in result:\n                    relevant_count += result['is_relevant']\n                else:\n                    relevance = self.calculate_binary_relevance(ground_truth, result['content'])\n                    relevant_count += relevance\n            \n            recall = relevant_count / total_relevant_docs\n            recall_scores[f'R@{k}'] = min(recall, 1.0)\n            \n        return recall_scores\n    \n    def calculate_ndcg_at_k(self, results, ground_truth, k_values=[1, 3, 5, 10]):\n        ndcg_scores = {}\n        \n        for k in k_values:\n            top_k = results[:k] if len(results) >= k else results\n            if not top_k:\n                ndcg_scores[f'NDCG@{k}'] = 0.0\n                continue\n            gains = []\n            for i, result in enumerate(top_k):\n                relevance = self.calculate_binary_relevance(ground_truth, result['content'])\n                gain = (2 ** relevance) - 1\n                discounted_gain = gain / np.log2(i + 2)\n                gains.append(discounted_gain)\n            \n            # Calculate DCG (Discounted Cumulative Gain)\n            dcg = sum(gains)\n            \n            # Calculate ideal DCG (IDCG)\n            # In ideal case, all relevant documents would be in first positions\n            ideal_gains = []\n            num_relevant = sum(1 for result in top_k if self.calculate_binary_relevance(ground_truth, result['content']))\n            for i in range(min(k, num_relevant)):\n                ideal_gain = (2 ** 1) - 1  # Gain for a relevant document\n                ideal_discounted_gain = ideal_gain / np.log2(i + 2)\n                ideal_gains.append(ideal_discounted_gain)\n            \n            idcg = sum(ideal_gains)\n            \n            # Calculate NDCG\n            ndcg = dcg / idcg if idcg > 0 else 0.0\n            ndcg_scores[f'NDCG@{k}'] = ndcg\n            \n        return ndcg_scores\n    \n    def calculate_mrr(self, results, ground_truth):\n        for i, result in enumerate(results):\n            if self.calculate_binary_relevance(ground_truth, result['content']):\n                return 1.0 / (i + 1)  # +1 because index starts at 0\n        return 0.0\n    \n    def calculate_map(self, results_list, ground_truths_list, k=10):\n        if len(results_list) != len(ground_truths_list):\n            return 0.0\n        \n        average_precisions = []\n        \n        for results, ground_truth in zip(results_list, ground_truths_list):\n            top_k = results[:k] if len(results) >= k else results\n            if not top_k:\n                continue\n            \n            # Calculate precision at each position where a relevant document is found\n            precisions = []\n            num_relevant_found = 0\n            \n            for i, result in enumerate(top_k):\n                if self.calculate_binary_relevance(ground_truth, result['content']):\n                    num_relevant_found += 1\n                    precision_at_i = num_relevant_found / (i + 1)\n                    precisions.append(precision_at_i)\n            \n            # Calculate Average Precision for this query\n            if precisions:\n                ap = sum(precisions) / len(precisions)\n                average_precisions.append(ap)\n        \n        # Calculate MAP\n        map_score = np.mean(average_precisions) if average_precisions else 0.0\n        return map_score\n    \n    def evaluate_retrieval_for_sample(self, idx, sample, k_values=[1, 3, 5, 10], similarity_threshold=0.7):\n        question = sample['processed_question'] if 'processed_question' in sample else sample['question_text']\n        ground_truth_answer = sample['processed_answer']\n        diagnosis = sample['Hierarchical Diagnosis'] if 'Hierarchical Diagnosis' in sample else None\n\n        if not isinstance(question, str) or len(question.strip()) < 3:\n            return None\n        \n        try:\n            # Retrieve results\n            retrieved_results = self.retriever.retrieve(\n                question,\n                k=max(k_values) * 2,\n                similarity_threshold=similarity_threshold\n            )\n\n            if not retrieved_results:\n                print(f\"Sample {idx}: No results found\")\n                return None\n            \n            # Re-ranking\n            reranked_results = self.retriever.rerank_with_medical_context(\n                question,\n                retrieved_results,\n                top_k=max(k_values)\n            )\n            \n            # Calculate advanced metrics\n            precision_scores = self.calculate_precision_at_k(\n                reranked_results, \n                ground_truth_answer, \n                k_values\n            )\n            \n            recall_scores = self.calculate_recall_at_k(\n                reranked_results,\n                ground_truth_answer,\n                total_relevant_docs=5,  # Estimation\n                k_values=k_values\n            )\n            \n            ndcg_scores = self.calculate_ndcg_at_k(\n                reranked_results,\n                ground_truth_answer,\n                k_values\n            )\n            \n            mrr_score = self.calculate_mrr(reranked_results, ground_truth_answer)\n            \n            metrics = {\n                'idx': idx,\n                'question': question[:100] + \"...\" if len(question) > 100 else question,\n                'diagnosis': diagnosis,\n                'ground_truth_length': len(ground_truth_answer),\n                'num_retrieved': len(reranked_results),\n                'precision_scores': precision_scores,\n                'recall_scores': recall_scores,\n                'ndcg_scores': ndcg_scores,\n                'mrr': mrr_score,\n                'retrieval_metrics': {}\n            }\n\n            # Calculate semantic similarities with ground truth\n            if len(ground_truth_answer) > 0:\n                gt_embedding = self.retriever.embedding_model.encode(\n                    [ground_truth_answer],\n                    normalize_embeddings=True\n                )[0]\n                \n                for result in reranked_results:\n                    retrieved_embedding = self.retriever.embedding_model.encode(\n                        [result['content']],\n                        normalize_embeddings=True\n                    )[0]\n                    \n                    similarity = np.dot(gt_embedding, retrieved_embedding) / (\n                        np.linalg.norm(gt_embedding) * np.linalg.norm(retrieved_embedding)\n                    )\n                    result['semantic_similarity_to_gt'] = float(similarity)\n\n            # Metrics by K (previous version kept for compatibility)\n            for k in k_values:\n                top_k = reranked_results[:k] if len(reranked_results) >= k else reranked_results\n\n                if diagnosis:\n                    same_diagnosis_count = sum(\n                        1 for r in top_k\n                        if r['metadata'].get('diagnosis') == diagnosis\n                    )\n                    diagnosis_recall = same_diagnosis_count / k\n                else:\n                    same_diagnosis_count = 0\n                    diagnosis_recall = 0\n\n                if top_k and 'semantic_similarity_to_gt' in top_k[0]:\n                    avg_semantic_similarity = np.mean([\n                        r['semantic_similarity_to_gt'] for r in top_k\n                    ])\n                    max_semantic_similarity = max([\n                        r['semantic_similarity_to_gt'] for r in top_k\n                    ])\n                else:\n                    avg_semantic_similarity = 0\n                    max_semantic_similarity = 0\n\n                metrics['retrieval_metrics'][f'k={k}'] = {\n                    'num_results': len(top_k),\n                    'same_diagnosis_count': same_diagnosis_count,\n                    'diagnosis_recall': diagnosis_recall,\n                    'avg_semantic_similarity': avg_semantic_similarity,\n                    'max_semantic_similarity': max_semantic_similarity,\n                    'avg_retrieval_score': np.mean([r.get('combined_score', r['similarity']) for r in top_k]),\n                    'top_score': top_k[0].get('combined_score', top_k[0]['similarity']) if top_k else 0,\n                    'precision': precision_scores.get(f'P@{k}', 0),\n                    'recall': recall_scores.get(f'R@{k}', 0),\n                    'ndcg': ndcg_scores.get(f'NDCG@{k}', 0)\n                }\n\n            # Find most semantically similar result\n            if reranked_results and 'semantic_similarity_to_gt' in reranked_results[0]:\n                most_similar = max(reranked_results, key=lambda x: x['semantic_similarity_to_gt'])\n                metrics['most_similar_result'] = {\n                    'semantic_similarity': most_similar['semantic_similarity_to_gt'],\n                    'retrieval_score': most_similar.get('combined_score', most_similar['similarity']),\n                    'diagnosis_match': most_similar['metadata'].get('diagnosis') == diagnosis,\n                    'content_preview': most_similar['content'][:200] + \"...\" if len(most_similar['content']) > 200 else most_similar['content']\n                }\n\n            print(f\"Sample {idx}: {len(reranked_results)} results, P@1: {precision_scores.get('P@1', 0):.3f}, MRR: {mrr_score:.3f}\")\n            return metrics\n\n        except Exception as e:\n            print(f\"Error for sample {idx}: {str(e)[:50]}\")\n            return None\n    \n    def evaluate_batch(self, sample_indices=None, max_samples=10, k_values=[1, 3, 5, 10]):\n        if sample_indices is None:\n            sample_indices = range(min(max_samples, len(self.test_data)))\n\n        print(f\"Evaluating retrieval on {len(sample_indices)} samples...\")\n        print(\"=\" * 70)\n\n        self.results = []\n        successful_evaluations = 0\n\n        for idx in sample_indices:\n            if idx >= len(self.test_data):\n                continue\n\n            sample = self.test_data.iloc[idx]\n            result = self.evaluate_retrieval_for_sample(idx, sample, k_values)\n\n            if result:\n                self.results.append(result)\n                successful_evaluations += 1\n                \n            if (idx + 1) % 10 == 0:\n                print(f\"Progress: {idx + 1}/{len(sample_indices)} samples processed\")\n\n        print(f\"\\nEvaluation completed: {successful_evaluations}/{len(sample_indices)} successful evaluations\")\n        return self.results\n    \n    def calculate_overall_metrics(self, k_values=[1, 3, 5, 10]):\n        if not self.results:\n            print(\"No evaluation results available\")\n            return None\n\n        overall_metrics = {\n            'num_samples': len(self.results),\n            'k_metrics': {f'k={k}': {} for k in k_values},\n            'precision_metrics': {},\n            'recall_metrics': {},\n            'ndcg_metrics': {},\n            'mrr': 0,\n            'diagnosis_analysis': {},\n            'similarity_distribution': {}\n        }\n\n        # Calculate aggregated metrics for each k\n        for k in k_values:\n            k_key = f'k={k}'\n            \n            # Initialize lists for metrics\n            diagnosis_recalls = []\n            semantic_similarities = []\n            retrieval_scores = []\n            precisions = []\n            recalls = []\n            ndcgs = []\n            \n            for result in self.results:\n                if k_key in result['retrieval_metrics']:\n                    metrics = result['retrieval_metrics'][k_key]\n                    \n                    diagnosis_recalls.append(metrics['diagnosis_recall'])\n                    semantic_similarities.append(metrics['avg_semantic_similarity'])\n                    retrieval_scores.append(metrics['avg_retrieval_score'])\n                    precisions.append(metrics['precision'])\n                    recalls.append(metrics['recall'])\n                    ndcgs.append(metrics['ndcg'])\n            \n            # Store metrics for this k\n            overall_metrics['k_metrics'][k_key] = {\n                'avg_diagnosis_recall': np.mean(diagnosis_recalls) if diagnosis_recalls else 0,\n                'avg_semantic_similarity': np.mean(semantic_similarities) if semantic_similarities else 0,\n                'avg_retrieval_score': np.mean(retrieval_scores) if retrieval_scores else 0,\n                'median_semantic_similarity': np.median(semantic_similarities) if semantic_similarities else 0,\n                'std_semantic_similarity': np.std(semantic_similarities) if semantic_similarities else 0,\n                'num_samples_with_data': len(diagnosis_recalls)\n            }\n            \n            # Ranking metrics\n            overall_metrics['precision_metrics'][f'P@{k}'] = {\n                'mean': np.mean(precisions) if precisions else 0,\n                'median': np.median(precisions) if precisions else 0,\n                'std': np.std(precisions) if precisions else 0,\n                'min': np.min(precisions) if precisions else 0,\n                'max': np.max(precisions) if precisions else 0\n            }\n            \n            overall_metrics['recall_metrics'][f'R@{k}'] = {\n                'mean': np.mean(recalls) if recalls else 0,\n                'median': np.median(recalls) if recalls else 0,\n                'std': np.std(recalls) if recalls else 0,\n                'min': np.min(recalls) if recalls else 0,\n                'max': np.max(recalls) if recalls else 0\n            }\n            \n            overall_metrics['ndcg_metrics'][f'NDCG@{k}'] = {\n                'mean': np.mean(ndcgs) if ndcgs else 0,\n                'median': np.median(ndcgs) if ndcgs else 0,\n                'std': np.std(ndcgs) if ndcgs else 0,\n                'min': np.min(ndcgs) if ndcgs else 0,\n                'max': np.max(ndcgs) if ndcgs else 0\n            }\n        \n        # Calculate global MRR\n        mrr_scores = [result['mrr'] for result in self.results if 'mrr' in result]\n        overall_metrics['mrr'] = {\n            'mean': np.mean(mrr_scores) if mrr_scores else 0,\n            'median': np.median(mrr_scores) if mrr_scores else 0,\n            'std': np.std(mrr_scores) if mrr_scores else 0,\n            'min': np.min(mrr_scores) if mrr_scores else 0,\n            'max': np.max(mrr_scores) if mrr_scores else 0\n        }\n        \n        # Calculate MAP\n        results_list = [result.get('reranked_results', []) for result in self.results]\n        ground_truths_list = [self.test_data.iloc[result['idx']]['processed_answer'] for result in self.results]\n        map_score = self.calculate_map(results_list, ground_truths_list, k=10)\n        overall_metrics['map'] = map_score\n        \n        # Analysis by diagnosis (kept from previous version)\n        diagnosis_counts = {}\n        diagnosis_similarities = {}\n\n        for result in self.results:\n            diagnosis = result['diagnosis']\n            if diagnosis:\n                if diagnosis not in diagnosis_counts:\n                    diagnosis_counts[diagnosis] = 0\n                    diagnosis_similarities[diagnosis] = []\n\n                diagnosis_counts[diagnosis] += 1\n\n                if 'most_similar_result' in result:\n                    diagnosis_similarities[diagnosis].append(\n                        result['most_similar_result']['semantic_similarity']\n                    )\n\n        # Keep most frequent diagnoses\n        top_diagnoses = sorted(diagnosis_counts.items(), key=lambda x: x[1], reverse=True)[:10]\n\n        for diagnosis, count in top_diagnoses:\n            similarities = diagnosis_similarities.get(diagnosis, [])\n            overall_metrics['diagnosis_analysis'][diagnosis] = {\n                'count': count,\n                'avg_similarity': np.mean(similarities) if similarities else 0,\n                'median_similarity': np.median(similarities) if similarities else 0,\n                'coverage': count / len(self.results)\n            }\n\n        # Similarity distribution\n        all_similarities = []\n        for result in self.results:\n            if 'most_similar_result' in result:\n                all_similarities.append(result['most_similar_result']['semantic_similarity'])\n\n        if all_similarities:\n            overall_metrics['similarity_distribution'] = {\n                'mean': np.mean(all_similarities),\n                'median': np.median(all_similarities),\n                'std': np.std(all_similarities),\n                'min': np.min(all_similarities),\n                'max': np.max(all_similarities),\n                'q1': np.percentile(all_similarities, 25),\n                'q3': np.percentile(all_similarities, 75),\n                'num_high_similarity': sum(1 for s in