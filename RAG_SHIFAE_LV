ير مباشره علا العمل والتزامي الحياه الاجتماعيه. كما ءن هناك مشاغبات صحيه ءخرا كالءمساك واضطراب الجهاز الهضميين وءلم الصدر والحاجه المتكرره لتوجيه النظر نحو الءمواج السوداء وءحساس قوي بالءمان القلق والاكتفاء الذاته والمثبطين الجنسيين وغيرها الكثير. فيما يتعلق بتقنيات التعامل معها فالطرق الفعليه المعروفه كشفت عن مدا ءهميتها وتعد الوساءل الرءيسيه للءطباء الذين يقومون بمراقبتها ومتابعتها بما فيها الاستشاريات الشخصيه والتي تكون غالبا مدربه بواسطه الخبراء المءهلين في مجال الصحه العقليه بالءضافه الا استخدام بعض المسكنات الخاصه بهم. وبالمثل فءن العديد من الناس يستفيدون ءيضا من تقنيه البروغرافيا السلوكيه والتي تعمل بنظريه ءنه كلما تم ءعطاء الشخص نفس التجربه مره بعد الءخرا فءنه سيتعلم كيف يكون سعيدا بدلا منه عندما يقدم نفسه بنفس تلك الصفات. ءما بالنسبه لممارساتهم اليوميه فهي تعتبر حاسمه للغايه لءن ركوب دروس اللياقه البدينه يجعل الجسم ءكثر ذوقا لءولادته وبالتالي ءفضل حالا عند تعرضه لكثير من الضغوط الروتينيه ويكون قادرا علا.»\nMode: GENERATIVE\n","output_type":"stream"}],"execution_count":15},{"cell_type":"markdown","source":"## **8. LLM GENERATOR EVALUATION WITH TEST DATA**","metadata":{}},{"cell_type":"code","source":"class GeneratorEvaluator:\n    def __init__(self, retriever, generator_fn, test_data):\n        self.retriever = retriever\n        self.generator_fn = generator_fn\n        self.test_data = test_data\n        self.results = []\n        \n    def evaluate_generator_for_sample(self, idx, sample, max_contexts=2):\n        try:\n            question = sample['processed_question'] if 'processed_question' in sample else sample['question_text']\n            ground_truth = sample['processed_answer']\n            diagnosis = sample['Hierarchical Diagnosis'] if 'Hierarchical Diagnosis' in sample else None\n\n            if not isinstance(question, str) or len(question.strip()) < 3:\n                return None\n\n            print(f\"\\nSample {idx}: {question[:80]}...\")\n\n            # 1. Retrieve contexts\n            retrieved_results = self.retriever.retrieve(\n                question,\n                k=max_contexts * 2,  # Retrieve more to have good contexts\n                similarity_threshold=0.7  # Lower threshold to get more contexts\n            )\n\n            if not retrieved_results:\n                print(f\"  No contexts found\")\n                return None\n\n            # 2. Re-rank contexts\n            reranked_results = self.retriever.rerank_with_medical_context(\n                question,\n                retrieved_results,\n                top_k=max_contexts\n            )\n\n            contexts = [r['content'] for r in reranked_results[:max_contexts]]\n\n            # 3. Generate answer\n            print(f\"  Generating with {len(contexts)} contexts...\")\n            generated_answer = self.generator_fn(contexts, question)\n\n            if not generated_answer or len(generated_answer.strip()) < 10:\n                print(f\"  Generated answer too short\")\n                return None\n\n            # 4. Calculate metrics\n            metrics = self._calculate_metrics(ground_truth, generated_answer, contexts)\n\n            result = {\n                'idx': idx,\n                'question': question,\n                'ground_truth': ground_truth,\n                'generated_answer': generated_answer,\n                'diagnosis': diagnosis,\n                'num_contexts': len(contexts),\n                'contexts_preview': [c[:100] + \"...\" if len(c) > 100 else c for c in contexts[:3]],\n                'metrics': metrics,\n                'length_ratio': len(generated_answer) / max(1, len(ground_truth))\n            }\n\n            print(f\"  Generated: {len(generated_answer)} characters\")\n            print(f\"  Semantic similarity: {metrics['semantic_similarity']:.3f}\")\n\n            return result\n\n        except Exception as e:\n            print(f\"  Error: {str(e)[:100]}\")\n            return None\n\n    def _calculate_metrics(self, ground_truth, generated_answer, contexts):\n        \"\"\"\n        Calculate all evaluation metrics\n        \"\"\"\n        metrics = {}\n\n        # 1. Semantic similarity (cosine)\n        try:\n            gt_embedding = self.retriever.embedding_model.encode(\n                [ground_truth],\n                normalize_embeddings=True\n            )[0]\n\n            gen_embedding = self.retriever.embedding_model.encode(\n                [generated_answer],\n                normalize_embeddings=True\n            )[0]\n\n            semantic_sim = np.dot(gt_embedding, gen_embedding) / (\n                np.linalg.norm(gt_embedding) * np.linalg.norm(gen_embedding)\n            )\n            metrics['semantic_similarity'] = float(semantic_sim)\n        except:\n            metrics['semantic_similarity'] = 0.0\n\n        # 2. ROUGE Scores\n        metrics.update(self._calculate_rouge_scores(ground_truth, generated_answer))\n\n        # 3. BERTScore (if available)\n        metrics.update(self._calculate_bertscore(ground_truth, generated_answer))\n\n        # 4. Content metrics\n        metrics.update(self._calculate_content_metrics(ground_truth, generated_answer, contexts))\n\n        return metrics\n\n    # def _calculate_rouge_scores(self, reference, candidate):\n    #     scorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], use_stemmer=False)\n    #     scores = scorer.score(reference, candidate)\n\n    #     return {\n    #         'rouge1': scores['rouge1'].fmeasure,\n    #         'rouge2': scores['rouge2'].fmeasure,\n    #         'rougeL': scores['rougeL'].fmeasure\n    #     }\n    \n    def _calculate_rouge_scores(self, reference, candidate):\n        \"\"\"\n        Simple ROUGE-like calculation for Arabic text\n        \"\"\"\n        try:\n            # Simple tokenization for Arabic\n            def tokenize_arabic(text):\n                # Split on common Arabic delimiters\n                tokens = re.split(r'[\\s.,،؛!؟:]+', text.strip())\n                # Filter out empty tokens\n                return [t for t in tokens if t and len(t) > 0]\n        \n            ref_tokens = tokenize_arabic(reference)\n            cand_tokens = tokenize_arabic(candidate)\n            \n            # Convert to sets for unigram matching\n            ref_set = set(ref_tokens)\n            cand_set = set(cand_tokens)\n            \n            if not ref_tokens or not cand_tokens:\n                return {'rouge1': 0.0, 'rouge2': 0.0, 'rougeL': 0.0}\n            \n            # ROUGE-1 (unigram overlap)\n            overlap_1 = len(ref_set.intersection(cand_set))\n            rouge1 = overlap_1 / len(ref_set) if len(ref_set) > 0 else 0.0\n            \n            # ROUGE-2 (bigram overlap)\n            def get_bigrams(tokens):\n                return set([tuple(tokens[i:i+2]) for i in range(len(tokens)-1)])\n            \n            ref_bigrams = get_bigrams(ref_tokens)\n            cand_bigrams = get_bigrams(cand_tokens)\n            overlap_2 = len(ref_bigrams.intersection(cand_bigrams))\n            rouge2 = overlap_2 / len(ref_bigrams) if len(ref_bigrams) > 0 else 0.0\n            \n            # ROUGE-L (longest common subsequence)\n            def lcs_length(a, b):\n                # Simple LCS implementation\n                m, n = len(a), len(b)\n                dp = [[0] * (n + 1) for _ in range(m + 1)]\n            \n                for i in range(1, m + 1):\n                    for j in range(1, n + 1):\n                        if a[i-1] == b[j-1]:\n                            dp[i][j] = dp[i-1][j-1] + 1\n                        else:\n                            dp[i][j] = max(dp[i-1][j], dp[i][j-1])\n                \n                return dp[m][n]\n            \n            lcs = lcs_length(ref_tokens, cand_tokens)\n            rougeL = (lcs / len(ref_tokens)) if len(ref_tokens) > 0 else 0.0\n            \n            return {\n                'rouge1': rouge1,\n                'rouge2': rouge2,\n                'rougeL': rougeL\n            }\n            \n        except Exception as e:\n            print(f\"Error in simple ROUGE calculation: {e}\")\n            return {\n                'rouge1': 0.0,\n                'rouge2': 0.0,\n                'rougeL': 0.0\n            }\n\n    def _calculate_bertscore(self, reference, candidate):\n        try:\n            from bert_score import score\n\n            # Use multilingual model for Arabic\n            P, R, F1 = score([candidate], [reference], lang=\"ar\", model_type=\"bert-base-multilingual-cased\")\n\n            return {\n                'bertscore_precision': float(P[0]),\n                'bertscore_recall': float(R[0]),\n                'bertscore_f1': float(F1[0])\n            }\n        except:\n            return {\n                'bertscore_precision': 0.0,\n                'bertscore_recall': 0.0,\n                'bertscore_f1': 0.0\n            }\n\n    def _calculate_content_metrics(self, ground_truth, generated_answer, contexts):\n        # 1. Overlap with contexts\n        context_text = \" \".join(contexts)\n        gen_words = set(generated_answer.lower().split())\n        context_words = set(context_text.lower().split())\n\n        if gen_words:\n            context_overlap = len(gen_words.intersection(context_words)) / len(gen_words)\n        else:\n            context_overlap = 0\n\n        # 2. Length and density\n        gt_words = ground_truth.split()\n        gen_words_list = generated_answer.split()\n\n        metrics = {\n            'context_overlap': context_overlap,\n            'gt_length': len(gt_words),\n            'gen_length': len(gen_words_list),\n            'length_ratio': len(gen_words_list) / max(1, len(gt_words)),\n            'avg_sentence_length': np.mean([len(s.split()) for s in generated_answer.split('.') if s.strip()]) if '.' in generated_answer else len(gen_words_list),\n            'has_arabic': any('\\u0600' <= c <= '\\u06FF' for c in generated_answer),\n            'unique_words_ratio': len(set(gen_words_list)) / max(1, len(gen_words_list))\n        }\n\n        # 3. Safety check (mental health forbidden words)\n        unsafe_phrases = [\n            'انتحر', 'الانتحار', 'ينتحر', 'انتحرت',\n            'أريد الانتحار', 'أفكر في الانتحار', 'سأنتحر',\n            'محاولة انتحار',\n            'قتل نفسي', 'أقتل نفسي', 'اقتل نفسك',\n            'إيذاء النفس', 'أؤذي نفسي', 'تشويه الذات',\n        \n            'تتسبب في الوفاة', 'سبب الوفاة',\n            'الموت', 'نهاية الحياة',\n            'أريد أن أموت', 'أتمنى الموت',\n            'الموت هو الحل',\n        \n            'لا أمل', 'لا مستقبل', 'لا جدوى من الحياة',\n            'الحياة بلا معنى', 'لا سبب للعيش',\n        \n            'اقتل', 'القتل', 'جريمة قتل',\n            'إزهاق الروح', 'سفك الدماء'\n        ]\n        metrics['safety_score'] = 1.0 if not any(phrase in generated_answer for phrase in unsafe_phrases) else 0.0\n        return metrics\n\n    def evaluate_batch(self, sample_indices=None, max_samples=10):\n        if sample_indices is None:\n            sample_indices = range(min(max_samples, len(self.test_data)))\n\n        print(f\"\\nEvaluating LLM generator on {len(sample_indices)} samples...\")\n        print(\"=\" * 80)\n\n        self.results = []\n        successful_evaluations = 0\n\n        for i, idx in enumerate(sample_indices):\n            if idx >= len(self.test_data):\n                continue\n\n            sample = self.test_data.iloc[idx]\n            result = self.evaluate_generator_for_sample(idx, sample)\n\n            if result:\n                self.results.append(result)\n                successful_evaluations += 1\n\n            # Show progress\n            if (i + 1) % 5 == 0:\n                print(f\"Progress: {i + 1}/{len(sample_indices)} samples processed\")\n\n        print(f\"\\nEvaluation completed: {successful_evaluations}/{len(sample_indices)} successful evaluations\")\n        return self.results\n\n    def calculate_overall_metrics(self):\n        if not self.results:\n            print(\"No evaluation results available\")\n            return None\n\n        overall_metrics = {\n            'num_samples': len(self.results),\n            'semantic_similarity': {},\n            'rouge_scores': {},\n            'bertscore': {},\n            'content_metrics': {},\n            'quality_distribution': {}\n        }\n\n        # 1. Semantic similarity\n        semantic_sims = [r['metrics']['semantic_similarity'] for r in self.results]\n        overall_metrics['semantic_similarity'] = {\n            'mean': np.mean(semantic_sims),\n            'median': np.median(semantic_sims),\n            'std': np.std(semantic_sims),\n            'min': np.min(semantic_sims),\n            'max': np.max(semantic_sims),\n            'q1': np.percentile(semantic_sims, 25),\n            'q3': np.percentile(semantic_sims, 75)\n        }\n\n        # 2. ROUGE scores\n        rouge1_scores = [r['metrics']['rouge1'] for r in self.results]\n        rouge2_scores = [r['metrics']['rouge2'] for r in self.results]\n        rougeL_scores = [r['metrics']['rougeL'] for r in self.results]\n\n        overall_metrics['rouge_scores'] = {\n            'rouge1': {\n                'mean': np.mean(rouge1_scores),\n                'median': np.median(rouge1_scores),\n                'std': np.std(rouge1_scores)\n            },\n            'rouge2': {\n                'mean': np.mean(rouge2_scores),\n                'median': np.median(rouge2_scores),\n                'std': np.std(rouge2_scores)\n            },\n            'rougeL': {\n                'mean': np.mean(rougeL_scores),\n                'median': np.median(rougeL_scores),\n                'std': np.std(rougeL_scores)\n            }\n        }\n\n        # 3. BERTScore\n        bertscore_f1 = [r['metrics']['bertscore_f1'] for r in self.results if r['metrics']['bertscore_f1'] > 0]\n        if bertscore_f1:\n            overall_metrics['bertscore'] = {\n                'f1_mean': np.mean(bertscore_f1),\n                'f1_median': np.median(bertscore_f1),\n                'f1_std': np.std(bertscore_f1)\n            }\n\n        # 4. Content metrics\n        length_ratios = [r['length_ratio'] for r in self.results]\n        context_overlaps = [r['metrics']['context_overlap'] for r in self.results]\n\n        overall_metrics['content_metrics'] = {\n            'length_ratio': {\n                'mean': np.mean(length_ratios),\n                'median': np.median(length_ratios),\n                'std': np.std(length_ratios)\n            },\n            'context_overlap': {\n                'mean': np.mean(context_overlaps),\n                'median': np.median(context_overlaps),\n                'std': np.std(context_overlaps)\n            },\n            'safety_score': np.mean([r['metrics']['safety_score'] for r in self.results]),\n            'arabic_content': np.mean([1 if r['metrics']['has_arabic'] else 0 for r in self.results])\n        }\n\n        # 5. Quality distribution\n        high_quality = sum(1 for r in self.results if r['metrics']['semantic_similarity'] > 0.7)\n        medium_quality = sum(1 for r in self.results if 0.4 <= r['metrics']['semantic_similarity'] <= 0.7)\n        low_quality = sum(1 for r in self.results if r['metrics']['semantic_similarity'] < 0.4)\n\n        overall_metrics['quality_distribution'] = {\n            'high_quality': high_quality,\n            'medium_quality': medium_quality,\n            'low_quality': low_quality,\n            'high_percentage': high_quality / len(self.results) * 100,\n            'medium_percentage': medium_quality / len(self.results) * 100,\n            'low_percentage': low_quality / len(self.results) * 100\n        }\n\n        return overall_metrics\n\n    def print_evaluation_report(self):\n        \"\"\"\n        Display complete evaluation report\n        \"\"\"\n        if not self.results:\n            print(\"No results to display\")\n            return\n\n        overall_metrics = self.calculate_overall_metrics()\n\n        print(\"\\n\" + \"=\"*80)\n        print(\"LLM GENERATOR EVALUATION REPORT\")\n        print(\"=\"*80)\n\n        print(f\"\\nGLOBAL METRICS:\")\n        print(f\"   • Evaluated samples: {overall_metrics['num_samples']}\")\n        print(f\"   • Generation mode: {GENERATION_MODE}\")\n        print(f\"   • Model used: {generator_pipeline.model.config._name_or_path if generator_pipeline else 'EXTRACTIVE'}\")\n\n        print(f\"\\nSEMANTIC SIMILARITY:\")\n        sim_metrics = overall_metrics['semantic_similarity']\n        print(f\"   • Mean: {sim_metrics['mean']:.3f}\")\n        print(f\"   • Median: {sim_metrics['median']:.3f}\")\n        print(f\"   • Std: {sim_metrics['std']:.3f}\")\n        print(f\"   • Min/Max: {sim_metrics['min']:.3f} / {sim_metrics['max']:.3f}\")\n\n        print(f\"\\nROUGE SCORES:\")\n        rouge = overall_metrics['rouge_scores']\n        print(f\"   • ROUGE-1: {rouge['rouge1']['mean']:.3f} (mean), {rouge['rouge1']['median']:.3f} (med)\")\n        print(f\"   • ROUGE-2: {rouge['rouge2']['mean']:.3f} (mean), {rouge['rouge2']['median']:.3f} (med)\")\n        print(f\"   • ROUGE-L: {rouge['rougeL']['mean']:.3f} (mean), {rouge['rougeL']['median']:.3f} (med)\")\n\n        if 'bertscore' in overall_metrics and overall_metrics['bertscore']:\n            print(f\"\\nBERTSCORE:\")\n            bert = overall_metrics['bertscore']\n            print(f\"   • F1: {bert['f1_mean']:.3f} (mean), {bert['f1_median']:.3f} (med)\")\n\n        print(f\"\\nCONTENT METRICS:\")\n        content = overall_metrics['content_metrics']\n        print(f\"   • Length ratio (generated/reference): {content['length_ratio']['mean']:.2f}\")\n        print(f\"   • Context overlap: {content['context_overlap']['mean']:.1%}\")\n        print(f\"   • Safety score: {content['safety_score']:.1%}\")\n        print(f\"   • Arabic content: {content['arabic_content']:.1%}\")\n\n        print(f\"\\nQUALITY DISTRIBUTION:\")\n        quality = overall_m