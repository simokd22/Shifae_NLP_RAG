wers (<100 characters): 0\n   • Min: 229 characters\n   • Max: 14718 characters\n   • Average: 2090 characters\n   • Median: 1944 characters\n\n======================================================================\nPRÉTRAITEMENT TERMINÉ AVEC SUCCÈS!\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"## **3. DIVISION STRATIFIÉE DES DONNÉES PAR DIAGNOSTIC**","metadata":{}},{"cell_type":"code","source":"from sklearn.model_selection import train_test_split\nfrom collections import Counter\n\ndef create_stratified_split(data, test_size=5000, random_state=42):\n    # 1. Clean diagnoses\n    data = data.copy()\n    data['diagnosis_clean'] = data['Hierarchical Diagnosis'].fillna('Unknown')\n\n    # 2. Create a category for rare diagnoses\n    diagnosis_counts = Counter(data['diagnosis_clean'])\n    rare_threshold = 5  # Threshold to consider a diagnosis as rare\n\n    # Categorize diagnoses\n    def categorize_diagnosis(diagnosis):\n        if diagnosis_counts[diagnosis] <= rare_threshold:\n            return 'RARE_CATEGORY'\n        return diagnosis\n\n    data['diagnosis_category'] = data['diagnosis_clean'].apply(categorize_diagnosis)\n\n    # 3. Stratify by diagnosis\n    # print(f\"Diagnosis category distribution:\")\n    # for category, count in Counter(data['diagnosis_category']).most_common():\n    #     print(f\"   • {category[:50]}: {count} samples\")\n\n    # 4. Stratified split\n    train_data, test_data = train_test_split(\n        data,\n        test_size=test_size,\n        stratify=data['diagnosis_category'],\n        random_state=random_state\n    )\n\n    # Clean temporary columns\n    train_data = train_data.drop(['diagnosis_clean', 'diagnosis_category'], axis=1)\n    test_data = test_data.drop(['diagnosis_clean', 'diagnosis_category'], axis=1)\n\n    return train_data.reset_index(drop=True), test_data.reset_index(drop=True)\n\n# Apply stratified split\ntest_size = 5000\ntrain_data, test_data = create_stratified_split(data, test_size=test_size)\n\nprint(f\"\\nStratified split completed:\")\nprint(f\"   • Train: {len(train_data):,} samples\")\nprint(f\"   • Test: {len(test_data):,} samples\")\nprint(f\"   • Test ratio: {len(test_data)/len(data)*100:.1f}%\")\n\n# Verify diagnosis distribution\nprint(\"\\nDIAGNOSIS DISTRIBUTION VERIFICATION:\")\n\ndef analyze_diagnosis_distribution(train_df, test_df, diagnosis_col='Hierarchical Diagnosis'):\n    \n    train_diag = train_df[diagnosis_col].fillna('Unknown').value_counts()\n    test_diag = test_df[diagnosis_col].fillna('Unknown').value_counts()\n\n    # Diagnoses present in both sets\n    common_diag = set(train_diag.index) & set(test_diag.index)\n\n    print(f\"   • Unique diagnoses in train: {len(train_diag)}\")\n    print(f\"   • Unique diagnoses in test: {len(test_diag)}\")\n    print(f\"   • Common diagnoses: {len(common_diag)}\")\n\n    # Check main diagnoses\n    print(f\"\\nTop 10 diagnosis distribution:\")\n    all_diag = data[diagnosis_col].fillna('Unknown').value_counts()\n\n    for diag, count in all_diag.head(10).items():\n        train_count = train_diag.get(diag, 0)\n        test_count = test_diag.get(diag, 0)\n        train_pct = train_count / count * 100 if count > 0 else 0\n        test_pct = test_count / count * 100 if count > 0 else 0\n\n        print(f\"     • {diag[:40]}...\")\n        print(f\"       Total: {count}, Train: {train_count} ({train_pct:.1f}%), \"\n              f\"Test: {test_count} ({test_pct:.1f}%)\")\n\nanalyze_diagnosis_distribution(train_data, test_data)\n\n# Check if we have enough data for each diagnosis\nprint(\"\\nDIAGNOSIS DISTRIBUTION ANALYSIS:\")\ndiagnosis_dist = data['Hierarchical Diagnosis'].fillna('Unknown').value_counts()\n\nprint(f\"   • Total unique diagnoses: {len(diagnosis_dist)}\")\nprint(f\"   • Diagnoses with 1 sample: {(diagnosis_dist == 1).sum()}\")\nprint(f\"   • Diagnoses with 2-5 samples: {((diagnosis_dist >= 2) & (diagnosis_dist <= 5)).sum()}\")\nprint(f\"   • Diagnoses with more than 5 samples: {(diagnosis_dist > 5).sum()}\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"CREATING CHUNKS WITH COVERAGE VERIFICATION\")\n\ndef create_sliding_window_chunks(text: str,chunk_size: int = 500, overlap: int = 100, min_chunk_size: int = 100) -> list:\n    if not isinstance(text, str) or not text.strip():\n        return []\n\n    if len(text) <= chunk_size:\n        return [text]\n\n    chunks = []\n    start = 0\n    while start < len(text):\n        end = start + chunk_size\n        chunk = text[start:end].strip()\n        if len(chunk) >= min_chunk_size:\n            chunks.append(chunk)\n        start = end - overlap\n    return chunks\n\n\n# Create chunks with diagnosis coverage verification\ndef create_chunks_with_coverage_verification(train_df):\n    print(\"Applying adaptive chunking...\")\n\n    CHUNK_SIZE = 600\n    OVERLAP = 100\n    MIN_CHUNK_SIZE = 100\n\n    train_df = train_df.copy()\n    train_df['answer_chunks'] = train_df['processed_answer'].apply(\n        lambda x: create_sliding_window_chunks(\n            str(x),\n            chunk_size=CHUNK_SIZE,\n            overlap=OVERLAP,\n            min_chunk_size=MIN_CHUNK_SIZE\n        ) if isinstance(x, str) and len(x.strip()) > 0 else []\n    )\n\n    # Verify each diagnosis has chunks\n    print(\"\\nDIAGNOSIS COVERAGE:\")\n\n    documents = []\n    metadata = []\n    coverage_by_diagnosis = {}\n\n    for idx, row in train_df.iterrows():\n        chunks = row['answer_chunks']\n        diagnosis = row.get('Hierarchical Diagnosis', 'Unknown')\n\n        if diagnosis not in coverage_by_diagnosis:\n            coverage_by_diagnosis[diagnosis] = {'chunks': 0, 'documents': 0}\n\n        for chunk_idx, chunk in enumerate(chunks):\n            if not isinstance(chunk, str) or len(chunk.strip()) < MIN_CHUNK_SIZE:\n                continue\n\n            word_count = len(chunk.split())\n\n            documents.append(chunk)\n            coverage_by_diagnosis[diagnosis]['chunks'] += 1\n\n            meta = {\n                'doc_id': int(idx),\n                'chunk_id': chunk_idx,\n                'total_chunks': len(chunks),\n                'chunk_position': chunk_idx + 1,\n                'word_count': word_count,\n                'char_count': len(chunk),\n                'diagnosis': diagnosis,\n                'source': 'train'\n            }\n\n            if 'processed_question' in row and isinstance(row['processed_question'], str):\n                question = row['processed_question']\n                if len(question) > 150:\n                    question = question[:150] + \"...\"\n                meta['question'] = question\n\n            metadata.append(meta)\n\n    # Display coverage\n    print(f\"\\n   • Total chunks created: {len(documents):,}\")\n    print(f\"   • Diagnoses covered: {len(coverage_by_diagnosis)}\")\n\n    # Diagnoses with few chunks\n    low_coverage = {k: v for k, v in coverage_by_diagnosis.items() if v['chunks'] < 3}\n    if low_coverage:\n        print(f\"\\nDiagnoses with low coverage (<3 chunks):\")\n        for diag, stats in low_coverage.items():\n            print(f\"     • {diag[:50]}: {stats['chunks']} chunks\")\n\n    return documents, metadata, train_data\n\n# Create chunks\ndocuments, metadata, train_data = create_chunks_with_coverage_verification(train_data)","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6_V_rcPhsHO-","outputId":"14a28539-15d0-40cf-9cf7-c90acbdd0f4c","trusted":true,"execution":{"iopub.status.busy":"2025-12-30T10:42:13.104624Z","iopub.execute_input":"2025-12-30T10:42:13.105208Z","iopub.status.idle":"2025-12-30T10:42:16.542270Z","shell.execute_reply.started":"2025-12-30T10:42:13.105178Z","shell.execute_reply":"2025-12-30T10:42:16.541589Z"}},"outputs":[{"name":"stdout","text":"\nStratified split completed:\n   • Train: 30,613 samples\n   • Test: 5,000 samples\n   • Test ratio: 14.0%\n\nDIAGNOSIS DISTRIBUTION VERIFICATION:\n   • Unique diagnoses in train: 118\n   • Unique diagnos