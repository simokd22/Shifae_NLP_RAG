ssfully\n   • Dimension: 384\n   • Description: Multilingual - Lightweight and effective for Arabic\n\nSelected model: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2\nEmbedding dimension: 384\n\nGenerating embeddings for 137,100 chunks...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/1072 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"32af8943c8544df6a91dd34ef4477c6a"}},"metadata":{}},{"name":"stdout","text":"\nEmbeddings generated successfully\n   • Shape: (137100, 384)\n   • Estimated memory: 200.8 MB\n\nVerifying embedding quality...\n   • Average norm: 1.0000\n\nCreating FAISS index...\nUsing IndexIVFFlat (large dataset)\nFAISS index created with 137,100 vectors\n\nSearch tests...\n'أعراض الاكتئاب الشديد' → similarity: 0.747\n'علاج القلق والتوتر' → similarity: 0.842\n'كيفية التعامل مع نوبات الهلع' → similarity: 0.711\n\n======================================================================\nRAG SYSTEM SUMMARY:\n======================================================================\n   • Knowledge base: 137,100 chunks\n   • Embeddings: 137,100 vectors\n   • Dimension: 384 dimensions\n   • Model: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2\n   • Chunking rate: 4.48 chunks/answer\n\nRAG system ready for use!\n======================================================================\n","output_type":"stream"}],"execution_count":13},{"cell_type":"markdown","source":"## **5. RETRIEVAL SYSTEM FOR MEDICAL ANSWERS**","metadata":{}},{"cell_type":"code","source":"class MedicalAnswerRetriever:\n    def __init__(self, embedding_model, cross_encoder, faiss_index, metadata, documents):\n        self.embedding_model = embedding_model\n        self.index = faiss_index\n        self.metadata = metadata\n        self.documents = documents\n        self.cross_encoder = cross_encoder\n        self._validate_data()\n\n    def _validate_data(self):\n        print(\"Validating retrieval data...\")\n        issues = []\n        if self.index.ntotal == 0:\n            issues.append(\"FAISS index is empty\")\n        if len(self.documents) == 0:\n            issues.append(\"No documents available\")\n        if len(self.metadata) == 0:\n            issues.append(\"No metadata available\")\n        if self.index.ntotal != len(self.documents):\n            issues.append(f\"Index/documents inconsistency: {self.index.ntotal} vs {len(self.documents)}\")\n        if len(self.metadata) != len(self.documents):\n            issues.append(f\"Metadata/documents inconsistency: {len(self.metadata)} vs {len(self.documents)}\")\n        if issues:\n            print(f\"Detected issues: {', '.join(issues)}\")\n        else:\n            print(f\"Data validated: {len(self.documents)} answer chunks\")\n\n    def retrieve(self, query: str, k: int = 10, similarity_threshold: float = 0.6) -> List[Dict]:\n        if self.index.ntotal == 0:\n            print(\"Warning: FAISS index is empty - no medical answers indexed\")\n            return []\n        processed_query = clean_medical_text(query)\n        if not processed_query or len(processed_query.strip()) < 3:\n            print(\"Query too short after preprocessing\")\n            return []\n\n        try:\n            query_embedding = self.embedding_model.encode(\n                [processed_query],\n                normalize_embeddings=True,\n                show_progress_bar=False\n            )\n        except Exception as e:\n            print(f\"Error generating embedding: {e}\")\n            return []\n\n        actual_k = min(k * 2, self.index.ntotal)\n\n        try:\n            distances, indices = self.index.search(query_embedding, actual_k)\n        except Exception as e:\n            print(f\"Error during FAISS search: {e}\")\n            return []\n\n        results = []\n        seen_doc_ids = set()\n\n        for dist, idx in zip(distances[0], indices[0]):\n            if idx == -1 or idx >= len(self.metadata) or idx >= len(self.documents):\n                continue\n            if dist < similarity_threshold:\n                continue\n            doc_id = self.metadata[idx].get('doc_id', idx)\n            if doc_id in seen_doc_ids:\n                continue\n\n            seen_doc_ids.add(doc_id)\n            result = {\n                'content': self.documents[idx],\n                'original_score': float(dist),\n                'similarity': float(dist),\n                'metadata': self.metadata[idx],\n                'chunk_id': idx,\n                'doc_id': doc_id\n            }\n            results.append(result)\n        results = sorted(results, key=lambda x: x['similarity'], reverse=True)[:k]\n\n        return results\n\n    def rerank_with_medical_context(self, query: str, initial_results: List[Dict], top_k: int = 10) -> List[Dict]:\n        if not initial_results:\n            return []\n\n        try:\n            doc_contents = [r['content'] for r in initial_results]\n\n            # Create query/chunk pairs\n            pairs = [(query, chunk) for chunk in doc_contents]\n\n            # Get scores directly from the model\n            scores = self.cross_encoder.predict(pairs)\n\n            # Apply scores for reranking\n            for i, result in enumerate(initial_results):\n                result['rerank_score'] = float(scores[i])\n                # Combine with original FAISS score if desired\n                result['combined_score'] = 0.7 * result['rerank_score'] + 0.3 * result['original_score']\n                if result['metadata'].get('total_chunks', 1) == 1:\n                    result['combined_score'] *= 1.1\n                if result['metadata'].get('diagnosis', 'N/A') != 'N/A':\n                    result['combined_score'] *= 1.05\n\n            # Sort and limit to top_k\n            reranked = sorted(initial_results, key=lambda x: x['combined_score'], reverse=True)\n            final_results = []\n            seen_doc_ids = set()\n\n            for result in reranked:\n                doc_id = result['metadata'].get('doc_id')\n                if doc_id not in seen_doc_ids:\n                    final_results.append(result)\n                    seen_doc_ids.add(doc_id)\n                if len(final_results) >= top_k:\n                    break\n            return final_results\n\n        except Exception as e:\n            print(f\"Error during cross-encoder re-ranking: {e}\")\n            return sorted(initial_results, key=lambda x: x['similarity'], reverse=True)[:top_k]\n\n    def format_results_for_display(self, results: List[Dict]) -> str:\n        if not results:\n            return \"No medical answers found.\"\n        formatted = \"\"\n        for i, result in enumerate(results):\n            formatted += f\"\\n{'='*60}\\n\"\n            formatted += f\"MEDICAL ANSWER #{i+1}\\n\"\n            formatted += f\"{'='*60}\\n\\n\"\n            formatted += f\"Score: {result.get('combined_score', result['similarity']):.4f}\\n\"\n            if 'question' in result['metadata']:\n                question = result['metadata']['question']\n                if len(question) > 150:\n                    question = question[:150] + \"...\"\n                formatted += f\"Question: {question}\\n\\n\"\n\n            # Diagnosis (if available)\n            if result['metadata'].get('diagnosis', 'N/A') != 'N/A':\n                formatted += f\"Diagnosis: {result['metadata']['diagnosis']}\\n\\n\"\n\n            # Answer content\n            content = result['content']\n            formatted += f\"Doctor's answer:\\n{content}\\n\\n\"\n\n            # Technical information\n            formatted += f\"Size: {len(content.split())} words, {len(content)} characters\\n\"\n            if 'chunk_position' in result['metadata']:\n                formatted += f\"Position: {result['metadata']['chunk_position']}\\n\"\n\n        return formatted\n\nprint(\"Initializing medical answer retriever...\")\ncross_encoder = CrossEncoder(\"sentence-transformers/paraphrase-multilingual-mpnet-base-v2\")\nretriever = MedicalAnswerRetriever(embedding_model, cross_encoder, index, metadata, documents)\n\nprint(f\"\\nRetriever initialized successfully!\")\nprint(f\"   • Available answer chunks: {len(documents):,}\")\nprint(f\"   • Vectors in index: {index.ntotal:,}\")","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":435,"referenced_widgets":["42b3678d43d744d5a7c6b31554c17f02","8d38852545614aa7bf3c739366df5b25","68fa0f4344f54208be50be6fb3d57f3c","2468cb70f82f43b9a96a196cc932cb4a","0f3ab60d845a47d2a195b1462aaf320c","ddb7a77826634edfb47cc7d13a90e0fc","452c9d619cac48e6a4e115e254a8b0e0","965976a8a93041e7aa9761fba1918b84","9de4eea870f3410ea47a5f26907ad3ce","5da631075fd44c4095e562c4cf1f73b1","649e922f68b1440fa9bc726b3d6eb8d0","d0c997f6114a4e9abb03c0c8b8b51d03","48a815a274e24256ab588957de75c06e","31d1d234f498483daf94418d42654bb4","068f11d923324e6db8496e20ac656fd0","32e8cab67fdd4199b0a7a7784cc360c6","41b523775f304d4688922fb6acc9027d","3221e8c28eb643d6b9ae4ebc7a204900","23460a85886b4585b8587b7b97890724","d949e57623174d2fb545477ec7f00b82","0cb558f501a748119d279b8776891fad","9fdc25356b2f436186d83a4ba73a6783","7bfbb272206246ea81a6a0dbf2c11b47","8c7876337a3c44628fff87490c9184fd","f82af9b0ff3544e69a3f6fd3340d15e3","88b75333f1ca4cbcb513d0532d9c43c0","a84902dab36546a98d3282152166e2bc","22071519861d4b3589d1abfa9d4abe48","5e61a10ccb194c898954455ab362b274","0ae3c272978c4ad8a5981fe806ce4af4","9170acc5942f41d2a4a877cc1f884eb2","175eb94afb3a446bb98dc020678b0c15","3ec31637311a476dbf2cee29f99938eb","9d1c32356f594effa738f4833a1c640e","25d3e40336454fc2b7ca1a2c9ebac880","2f738afc039a4d79a6a2d1e411c3c1f4","25c828afdcb747d5bb7c12cbf95efac0","1e324192f0a74c81b7fdcf2fec03a8f6","efacd9df584049ba9c7799cc753a96bd","079b18a6e6e845a493492ae7c496c3c8","016a8e9987e64474adf73e042cdeadb2","7f08885d5d7c4e148be7e86fac4ee0c7","9d3a4b4ad6cf4214a63894d358205298","cb3467c