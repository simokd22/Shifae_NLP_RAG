for Arabic\",\n        \"dimension\": 384\n    },\n    {\n        \"name\": \"intfloat/multilingual-e5-small\",\n        \"description\": \"Multilingual E5 - Good quality/performance balance\",\n        \"dimension\": 384\n    },\n    {\n        \"name\": \"Alibaba-NLP/gte-multilingual-base\",\n        \"description\": \"Multilingual GTE - High quality\",\n        \"dimension\": 768\n    }\n]\nembedding_model = None\nselected_model = None\n\nfor model_option in MODEL_CHOICES:\n    try:\n        print(f\"\\nAttempting: {model_option['name']}\")\n        embedding_model = SentenceTransformer(model_option['name'])\n        selected_model = model_option\n\n        # Test with Arabic text\n        test_text = \"الاكتئاب والقلق اضطرابات نفسية تحتاج علاج\"\n        test_embedding = embedding_model.encode(test_text, normalize_embeddings=True)\n\n        print(f\"Model loaded successfully\")\n        print(f\"   • Dimension: {len(test_embedding)}\")\n        print(f\"   • Description: {model_option['description']}\")\n        break\n\n    except Exception as e:\n        print(f\"Error: {str(e)[:80]}...\")\n        continue\n\nprint(f\"\\nSelected model: {selected_model['name']}\")\nprint(f\"Embedding dimension: {selected_model['dimension']}\")\n\n# 4.2 Generating embeddings\nprint(f\"\\nGenerating embeddings for {len(documents):,} chunks...\")\n\nbatch_size = 128 if len(documents) > 20000 else 64\n\ntry:\n    # Generate embeddings in batches\n    document_embeddings = embedding_model.encode(\n        documents,\n        show_progress_bar=True,\n        batch_size=batch_size,\n        normalize_embeddings=True,\n        convert_to_numpy=True\n    )\n\n    print(f\"\\nEmbeddings generated successfully\")\n    print(f\"   • Shape: {document_embeddings.shape}\")\n    print(f\"   • Estimated memory: {(document_embeddings.nbytes) / (1024**2):.1f} MB\")\n\n    print(\"\\nVerifying embedding quality...\")\n\n    nan_count = np.isnan(document_embeddings).sum()\n    if nan_count > 0:\n        print(f\"Correcting {nan_count} NaN values...\")\n        document_embeddings = np.nan_to_num(document_embeddings, nan=0.0)\n\n    norms = np.linalg.norm(document_embeddings, axis=1)\n    avg_norm = np.mean(norms)\n    print(f\"   • Average norm: {avg_norm:.4f}\")\n\n    if abs(avg_norm - 1.0) > 0.1:\n        print(f\"Renormalizing (norm: {avg_norm:.4f})...\")\n        document_embeddings = document_embeddings / norms[:, np.newaxis]\n\nexcept Exception as e:\n    print(f\"Embedding generation error: {e}\")\n    raise\n\n# 4.3 Creating FAISS index\nprint(\"\\nCreating FAISS index...\")\n\ndimension = document_embeddings.shape[1]\nindex = None\n\n# Choose index type based on size\nif len(documents) > 50000:\n    print(\"Using IndexIVFFlat (large dataset)\")\n\n    nlist = 100  # Number of clusters\n    quantizer = faiss.IndexFlatIP(dimension)\n    index = faiss.IndexIVFFlat(quantizer, dimension, nlist, faiss.METRIC_INNER_PRODUCT)\n\n    # Train on subset\n    train_size = min(20000, len(document_embeddings))\n    train_vectors = document_embeddings[:train_size]\n    index.train(train_vectors)\n\n    index.add(document_embeddings)\n    index.nprobe = 15  # Explore 15 clusters\n\nelse:\n    print(\"   Using IndexFlatIP (better precision)\")\n    index = faiss.IndexFlatIP(dimension)\n    index.add(document_embeddings)\n\nprint(f\"FAISS index created with {index.ntotal:,} vectors\")\n\n# 4.4 Basic tests\nprint(\"\\nSearch tests...\")\n\ntest_queries = [\n    \"أعراض الاكتئاب الشديد\",\n    \"علاج القلق والتوتر\",\n    \"كيفية التعامل مع نوبات الهلع\"\n]\n\nfor query in test_queries:\n    try:\n        query_embedding = embedding_model.encode([query], normalize_embeddings=True)\n        distances, indices = index.search(query_embedding, k=10)\n\n        if indices[0][0] >= 0:\n            idx = indices[0][0]\n            print(f\"'{query}' → similarity: {distances[0][0]:.3f}\")\n        else:\n            print(f\"'{query}' → no results\")\n\n    except Exception 